{
  "manifest_version": 3,
  "name": "Site Blocker",
  "version": "1.0.0",
  "description": "Blocks the sites in a local list file, with an off switch that always times out. blockctl turns it off and on from the shell.",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Site Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png"
    }
  },
  "omnibox": {
    "keyword": "sb"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "blocked.css",
        "ui.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  }
}
